# ---------------------------------------------------------------------------
# AutoLedger configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# 1) Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAEXAMPLE_replace_me

# 2) Comma-separated numeric Telegram user IDs allowed to use the bot.
#    Get yours by messaging @userinfobot. Anyone not listed is ignored entirely.
#    This is the only thing standing between your ledger and strangers — set it.
ALLOWED_TELEGRAM_IDS=111111111,222222222

# 3) Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace_me

# Optional: parsing model. Default is claude-opus-5 (best accuracy).
# Set to claude-haiku-4-5 to cut cost roughly 5x with slightly weaker parsing.
CLAUDE_MODEL=claude-opus-5

# 4) Google service account key, as one line of JSON, or base64 of that JSON.
#    Create it in Google Cloud (IAM > Service Accounts > Keys > Add key > JSON),
#    then enable the Google Sheets API for the project.
#
#    LEAVE THIS UNSET when running on Google Cloud. Attach the service account to
#    the function instead and Application Default Credentials supply the identity,
#    so no private key is stored anywhere. Only set it when running off-cloud.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"autoledger@example.iam.gserviceaccount.com"}

# 5) Spreadsheet ID, from the sheet URL:
#    docs.google.com/spreadsheets/d/<THIS PART>/edit
#    Share the sheet with the service account's client_email as an Editor.
SPREADSHEET_ID=replace_me

# Required only in webhook mode (Cloud Functions): the shared secret Telegram
# sends back in X-Telegram-Bot-Api-Secret-Token. The function URL is public and
# unauthenticated, so this is what proves a request really came from Telegram.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Optional: tab names and timezone.
SHEET_TRANSACTIONS=Transactions
SHEET_CONFIG=Config
TIMEZONE=Asia/Jakarta
